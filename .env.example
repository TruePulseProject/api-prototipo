# Copie para .env e ajuste. Todas as variáveis são opcionais.
TRUEPULSE_DEBUG=false

# Origens permitidas para o app Flutter (separe por vírgula em produção)
TRUEPULSE_CORS_ORIGINS=*

# Binários do ffmpeg (deixe assim se estiverem no PATH)
TRUEPULSE_FFMPEG_BIN=ffmpeg
TRUEPULSE_FFPROBE_BIN=ffprobe

# Captura esperada
TRUEPULSE_TARGET_FPS=30
TRUEPULSE_EXPECTED_DURATION_S=5
TRUEPULSE_DURATION_TOLERANCE_S=1.5
TRUEPULSE_MAX_UPLOAD_MB=60

# Decisão do modelo
TRUEPULSE_CHECKPOINT_NAME=truepulse_discriminator.pt
TRUEPULSE_DEEPFAKE_THRESHOLD_PCT=50
# true = sobe sem checkpoint, com pesos aleatorios (SOMENTE desenvolvimento)
TRUEPULSE_ALLOW_UNTRAINED_MODEL=false

# Video anotado com o retangulo do rosto
TRUEPULSE_ANNOTATE_VIDEO=true
TRUEPULSE_DRAW_ROIS=false

# Jobs
TRUEPULSE_JOB_TTL_MINUTES=30
TRUEPULSE_MAX_CONCURRENT_JOBS=1

# Token emitido no login aprovado - TROQUE ESTE VALOR
TRUEPULSE_JWT_SECRET=troque-este-segredo-em-producao
TRUEPULSE_JWT_TTL_MINUTES=15
